# ~/.config/n8n/n8n.env: the per-host settings of this n8n install (mode 0600).
# scripts/install.sh creates it from config/n8n.env.example and reads it on every run.
# Format: KEY=value lines only. No quotes, no "export", no "# comment" after a value.
#
# Two kinds of keys live here:
#   HOST_*   rendered into the unit files by scripts/install.sh (run it after a change)
#   the rest passed to the n8n container with --env-file, so any n8n environment
#            variable works; scripts/install.sh restarts n8n when this file changed
# No passwords here: install.sh creates the podman secrets n8n-db-password and
# n8n-runners-auth-token, and n8n-valkey-password in queue mode. Do not set N8N_PORT:
# it is n8n's port inside the container.

# ---- Host side (rendered into n8n.container) ---------------------------------------
# Publish address. Keep 127.0.0.1 when a Cloudflare tunnel or NPM on this host is the
# way in; 0.0.0.0 publishes on every interface.
HOST_BIND=127.0.0.1
HOST_PORT=15678
# Optional webhook processor listens here when N8N_QUEUE_WEBHOOK_PROCESSOR=true.
WEBHOOK_PORT=15679

# ---- Public URL ----------------------------------------------------------------------
# scripts/install.sh --public-url https://n8n.example.com/ sets N8N_HOST, N8N_PROTOCOL,
# N8N_EDITOR_BASE_URL, N8N_WEBHOOK_URL and N8N_PROXY_HOPS=1 (one proxy hop: cloudflared
# or NPM). Without them, webhooks and OAuth callbacks point at an unreachable address.
N8N_HOST=localhost
N8N_PROTOCOL=http
# Secure cookies stay on (n8n's default). Only a plain-http login from another machine
# (HOST_BIND=0.0.0.0 without a TLS proxy) needs N8N_SECURE_COOKIE=false; avoid it.

# ---- Misc ----------------------------------------------------------------------------
GENERIC_TIMEZONE=Asia/Taipei
TZ=Asia/Taipei

# ---- Task runners --------------------------------------------------------------------
# external: the n8n-runners sidecar runs Code-node JavaScript and Python outside the n8n
#           process (upstream's recommendation; enables the Python Code node).
# internal: no sidecar, code runs as a child of n8n (install.sh --no-runners sets this).
N8N_RUNNERS_MODE=external

# ---- Optional queue topology --------------------------------------------------------
# regular: one n8n process handles executions; no Valkey or worker is installed.
# queue: install a private password-protected Valkey, one worker and its own JS/Python
#        task-runner sidecar. Change this only after a cold backup; see README.
EXECUTIONS_MODE=regular
# Per-worker maximum concurrent queued executions (one worker container is installed).
WORKER_CONCURRENCY=5
# An additional webhook process in queue mode. Route /webhook/* and /webhook-waiting/*
# to WEBHOOK_PORT; keep /webhook-test/* and editor traffic on HOST_PORT.
N8N_QUEUE_WEBHOOK_PROCESSOR=false
# Set true only after the reverse proxy routes all production webhook paths to WEBHOOK_PORT.
# This setting is applied to the main process only.
N8N_QUEUE_DISABLE_MAIN_WEBHOOKS=false

# Match the HA add-on's workflow behavior. External Code nodes run in the isolated
# runner container, whose import permissions are pinned by n8n-task-runners.json.
# Workflow expressions can read any non-secret variables you add to this env file;
# keep provider credentials in n8n Credentials instead of here.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
