# What scripts/migrate-legacy.sh --public-url https://toypark1234-n8n.woowtech.io writes
# on toypark1234: loopback publish on the legacy port, the public tunnel URL, external
# task runners.
HOST_BIND=127.0.0.1
HOST_PORT=15678
N8N_HOST=toypark1234-n8n.woowtech.io
N8N_PROTOCOL=https
GENERIC_TIMEZONE=Asia/Taipei
TZ=Asia/Taipei
N8N_RUNNERS_MODE=external
N8N_EDITOR_BASE_URL=https://toypark1234-n8n.woowtech.io/
N8N_WEBHOOK_URL=https://toypark1234-n8n.woowtech.io/
N8N_PROXY_HOPS=1
